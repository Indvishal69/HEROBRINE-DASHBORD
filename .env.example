# Optional fallback settings for Java Edition. The dashboard settings are saved in data/settings.json.
MC_HOST=
MC_PORT=25565
MC_VERSION=auto

# Use microsoft for a normal authenticated server account.
# Use offline only for a server/world that explicitly allows offline-mode clients.
MC_AUTH=microsoft
MC_USERNAME=MinecraftBuddy

# Optional local web ports. Keep these on this computer only.
MC_GUI_PORT=3080
MC_VIEWER_PORT=3007
